// Fashion E-Commerce — Prisma schema.
// Tiền tệ: VND, lưu Int (không có phần thập phân).
// Extension `vector` đã được bật qua migration; CHƯA có cột embedding (sẽ thêm ở giai đoạn AI).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, unaccent]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  DELIVERED
  CANCELLED
}

// Ai thực hiện thay đổi trạng thái đơn.
enum OrderActorType {
  CUSTOMER
  ADMIN
  SYSTEM // job/cổng thanh toán (IPN), không gắn với user nào
}

// Cách hiển thị ảnh đại diện: chữ cái đầu (mặc định), ảnh tạo sẵn (DiceBear, sinh từ style + seed) hoặc ảnh tải lên.
enum AvatarKind {
  INITIALS
  GENERATED
  UPLOADED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  MOMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE) // LOCKED: Admin khoá, không đăng nhập/refresh được
  avatarKind   AvatarKind @default(INITIALS)
  avatarColor  String? // INITIALS: khoá màu nền trong bảng màu (src/lib/avatar.ts)
  avatarStyle  String? // GENERATED: kiểu DiceBear trong danh sách cho phép
  avatarSeed   String? // GENERATED: hạt giống ngẫu nhiên (không dùng email/tên thật)
  avatarUrl    String? // UPLOADED: /uploads/avatars/<uuid>.<ext>
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses                Address[]
  cart                     Cart?
  orders                   Order[]
  refreshTokens            RefreshToken[]
  orderStatusChanges       OrderStatusHistory[]
  aiChatLogs               AiChatLog[]
  notifications            Notification[]
  adminNotificationsSeenAt DateTime? // mốc "đã đọc" của hộp thư Admin: thông báo mới hơn mốc này là chưa đọc
  adminNotificationReads   AdminNotificationRead[]
  voucherAssignments       VoucherAssignment[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
}

// Refresh token opaque: chỉ lưu SHA-256 của token (không lưu token gốc).
// Mỗi lần refresh sẽ rotate: token cũ bị revoke, token mới cùng familyId.
// Token đã revoke mà bị dùng lại => coi là bị đánh cắp, revoke cả family.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  street    String
  ward      String
  province  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────── Catalog ────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())

  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  sizeCharts SizeChart[]
  vouchers   Voucher[]

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String
  material    String
  style       String // casual | formal | streetwear | smart-casual | minimalist | vintage | sporty | korean | elegant | bohemian ...
  occasion    String[]
  season      String[]
  gender      Gender
  tags        String[]
  basePrice   Int // VND
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false) // hiển thị ở mục "Nổi bật" trang chủ
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  variants      ProductVariant[]
  embedding     ProductEmbedding?
  reviews       Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId, isActive])
  @@index([isActive, basePrice])
  @@index([isActive, isFeatured])
  @@index([gender])
  @@index([style])
  @@index([brand])
  @@index([occasion], type: Gin)
  @@index([season], type: Gin)
  @@index([tags], type: Gin)
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  size      String
  color     String // tên hiển thị tiếng Việt, ví dụ "Đen", "Xanh navy"
  colorHex  String
  price     Int // VND
  stock     Int    @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([size])
  @@index([color])
}

// Vector ngữ nghĩa của sản phẩm cho Semantic Search (docs/ai/01-data-for-ai.md mục 3).
// Cột `embedding` là vector(1024) theo bge-m3; Prisma Client không đọc/ghi kiểu này nên dùng $queryRaw / $executeRaw.
// Chỉ mục HNSW (vector_cosine_ops) nằm trong file migration vì Prisma không biểu diễn được.
model ProductEmbedding {
  productId       String                      @id
  embedding       Unsupported("vector(1024)")
  content         String // đúng chuỗi đã embed
  contentHash     String // sha256(content | model | templateVersion)
  model           String
  dimensions      Int
  templateVersion Int                         @default(1)
  embeddedAt      DateTime                    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Đoạn kiến thức (chăm sóc, size, chính sách, phối đồ) nạp từ docs/ai/knowledge/*.md cho RAG (docs/ai/03-rag-advisor.md mục 1).
// Khoá tự nhiên là (source, title). `embedding` là vector(1024) theo bge-m3; chỉ đọc/ghi bằng SQL thô như ProductEmbedding.
// Không có chỉ mục vector: vài chục đoạn thì quét tuần tự đã đủ nhanh và tránh thêm lệch schema với Prisma.
model KnowledgeChunk {
  id              String                      @id
  source          String // tên file nguồn, ví dụ "care.md"
  type            String // care | styling | policy | faq
  title           String
  content         String
  metadata        Json
  embedding       Unsupported("vector(1024)")
  contentHash     String // sha256(tiêu đề + nội dung | model | templateVersion): đổi thì phải embed lại
  model           String
  templateVersion Int                         @default(1)
  updatedAt       DateTime                    @default(now())

  @@unique([source, title])
  @@index([type])
}

// Nhật ký một lượt chat với trợ lý (docs/ai/05-safety-and-guardrails.md mục 7). Mức 0 luôn ghi số liệu kỹ thuật và tên tool;
// `params` chỉ có ở mức 1 trở lên (đã che PII); `userText`/`replyText` chỉ có ở mức 2 và bị xoá sau vài ngày (purge).
model AiChatLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  level     Int
  model     String
  status    String // ok | fallback | error | bare_confirmation
  claim     String? // lý do cổng kiểm chứng can thiệp (catalog, size, order...), nếu có
  retries   Int      @default(0)
  latencyMs Int
  ttftMs    Int?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  tools     Json // [{ name, ok, code?, ms }]
  params    Json? // [{ name, input }] đã che PII (mức >= 1)
  error     String?
  userText  String? // mức 2
  replyText String? // mức 2

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Số đo tham chiếu (cm / kg) phục vụ tư vấn size bằng AI.
// brand = null: bảng size chung; có brand: bảng riêng của thương hiệu đó.
model SizeChart {
  id         String  @id @default(cuid())
  categoryId String
  brand      String?
  size       String
  chest      Int? // vòng ngực (cm) — null với quần
  waist      Int // vòng eo (cm)
  hip        Int // vòng mông (cm)
  heightMin  Int // cm
  heightMax  Int
  weightMin  Int // kg
  weightMax  Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, brand])
}

// ─────────────────────────── Cart & Order ───────────────────────────

// Giỏ của user đã đăng nhập, mỗi user một giỏ. Không có giỏ khách (cần tài khoản để dùng giỏ hàng).
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int      @default(1)
  priceAtAdd Int? // VND, giá lúc thêm/sửa gần nhất — để cảnh báo khi giá đổi. null = không rõ.
  createdAt  DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// Bộ đếm số thứ tự đơn theo ngày (day = YYYYMMDD, giờ Việt Nam) → mã đơn FS-YYYYMMDD-0001.
// Tăng bằng upsert increment trong transaction nên hai đơn đồng thời không trùng mã.
model OrderSequence {
  day  String @id
  last Int
}

model Order {
  id                     String        @id @default(cuid())
  code                   String        @unique // mã dễ đọc, vd FS-20261109-0001
  userId                 String
  status                 OrderStatus   @default(PENDING)
  subtotal               Int // VND, tổng tiền hàng
  shippingFee            Int           @default(0) // VND
  discount               Int           @default(0) // VND, số tiền mã GIẢM GIÁ (CASH/PERCENT) đã trừ vào tiền hàng
  voucherCode            String? // mã giảm giá đã áp (snapshot, không phụ thuộc voucher bị sửa/xoá sau này)
  shippingDiscount       Int           @default(0) // VND, số tiền mã VẬN CHUYỂN (FREESHIP) đã trừ vào phí ship
  shippingVoucherCode    String? // mã vận chuyển đã áp (snapshot)
  customerReportedPaidAt DateTime? // lúc khách bấm "Tôi đã chuyển khoản" (chỉ báo cho Admin; paymentStatus vẫn do Admin xác nhận)
  total                  Int // VND, = subtotal + shippingFee - discount - shippingDiscount tại thời điểm đặt
  note                   String?
  shippingAddress        Json // snapshot địa chỉ giao hàng
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus @default(PENDING)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  redemptions   VoucherRedemption[] // tối đa 2: một mã giảm giá + một mã vận chuyển

  @@index([userId, createdAt])
  @@index([status])
}

// Hạng thành viên, suy ra từ tổng chi tiêu (src/lib/customer-tier.ts); chỉ dùng để giới hạn voucher theo hạng.
enum CustomerTier {
  MEMBER
  SILVER
  GOLD
  DIAMOND
}

// Ai được dùng voucher: mọi khách, khách từ một hạng trở lên (minTier), hoặc chỉ khách được gán (VoucherAssignment).
enum VoucherAudience {
  ALL
  TIER
  USERS
}

enum VoucherType {
  CASH // giảm số tiền cố định (value = VND)
  PERCENT // giảm theo % hàng (value = %, có thể có trần maxDiscount)
  FREESHIP // trừ vào phí vận chuyển (value = VND tối đa)
}

// Mã giảm giá do Admin tạo. Áp khi đặt đơn (createOrder). Mỗi khách dùng tối đa 1 lần mỗi mã (VoucherRedemption).
model Voucher {
  id             String          @id @default(cuid())
  code           String          @unique // luôn IN HOA, không dấu cách
  name           String
  type           VoucherType
  value          Int
  maxDiscount    Int? // trần giảm cho PERCENT
  minOrder       Int             @default(0) // VND, tính trên phần hàng được áp dụng
  categoryId     String? // null = toàn bộ sản phẩm; có = chỉ hàng thuộc danh mục này (và danh mục con)
  firstOrderOnly Boolean         @default(false)
  usageLimit     Int? // null = không giới hạn
  usedCount      Int             @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean         @default(true)
  audience       VoucherAudience @default(ALL)
  minTier        CustomerTier? // audience = TIER: chỉ khách từ hạng này trở lên
  welcomeTier    CustomerTier? // có giá trị: tự gán cho khách khi họ lên tới hạng này (kèm audience = USERS)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  redemptions VoucherRedemption[]
  assignments VoucherAssignment[]

  @@index([isActive, expiresAt])
}

// Voucher gán riêng cho khách (audience = USERS), do Admin chọn hoặc tự cấp khi khách lên hạng (welcomeTier).
model VoucherAssignment {
  voucherId String
  userId    String
  auto      Boolean  @default(false) // true = hệ thống tự cấp khi khách lên hạng (welcomeTier); false = Admin chọn tay
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([voucherId, userId])
  @@index([userId])
}

// Một lượt dùng của một mã trên một đơn (một đơn có thể có hai: mã giảm giá + mã vận chuyển). Xoá khi đơn bị huỷ (hoàn lượt).
// Unique (voucher, user): mỗi khách dùng mỗi mã một lần, chống đua nhau.
model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@index([orderId])
}

// Nhật ký mỗi lần đổi trạng thái đơn (kể cả lúc tạo đơn: fromStatus = null) → dựng timeline.
model OrderStatusHistory {
  id          String         @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorType   OrderActorType
  actorUserId String? // null khi SYSTEM; SetNull nếu user bị xoá
  note        String? // lý do huỷ, nguồn thay đổi (vd "Đã thu tiền COD khi giao hàng")
  createdAt   DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// Snapshot tại thời điểm mua: sửa/xoá sản phẩm sau này không làm đổi đơn cũ.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  variantId   String? // giữ tham chiếu để thống kê; null nếu variant bị xoá
  productName String
  sku         String
  size        String
  color       String
  unitPrice   Int // VND
  quantity    Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

// Đánh giá sản phẩm: mỗi khách một đánh giá cho mỗi sản phẩm, chỉ khi có đơn DELIVERED chứa sản phẩm đó (kiểm ở service).
// Hiện ngay khi gửi; Admin ẩn sau (HIDDEN) và có thể hiện lại. Khách xoá đánh giá của mình thì xoá hẳn dòng.
enum ReviewStatus {
  VISIBLE
  HIDDEN
}

model Review {
  id           String       @id @default(cuid())
  userId       String
  productId    String
  rating       Int // 1–5
  content      String? // tối đa 1000 ký tự (Zod)
  status       ReviewStatus @default(VISIBLE)
  hiddenAt     DateTime?
  hiddenById   String? // Admin đã ẩn (không khoá ngoại: Admin bị xoá không làm mất đánh giá)
  hiddenReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ReviewImage[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

// Ảnh kèm đánh giá (tối đa 3, kiểm ở service): file nằm ở public/uploads/reviews, `url` do server sinh.
// `url` là duy nhất nên một ảnh không thể gắn vào hai đánh giá. File không còn dòng nào trỏ tới sẽ được dọn tự động (quá 24 giờ).
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, position])
}

// Danh sách yêu thích: mỗi khách một dòng cho mỗi sản phẩm (ràng buộc duy nhất), chỉ dành cho người đã đăng nhập.
// Sản phẩm bị ẩn (isActive = false) vẫn giữ dòng nhưng không hiện trong danh sách; xoá user hoặc sản phẩm thì xoá theo.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

// Thông tin cửa hàng hiển thị cho khách (trang Liên hệ, Giới thiệu, chân trang). Một dòng duy nhất, id = "default"; Admin sửa ở Cài đặt.
model StoreProfile {
  id        String   @id @default("default")
  hotline   String?
  email     String?
  address   String?
  about     String? // giới thiệu: các đoạn cách nhau bằng dòng trống
  updatedAt DateTime @updatedAt
}

// Quy tắc cửa hàng Admin chỉnh ở Cài đặt hệ thống (tồn kho, vận chuyển, hạng thành viên). Một dòng duy nhất, id = "default";
// chưa có dòng thì dùng giá trị mặc định trong code (lib/shop-settings.ts). Tiền: VND, số nguyên.
model ShopSettings {
  id                       String   @id @default("default")
  lowStockThreshold        Int      @default(10)
  flatShippingFee          Int      @default(30000)
  silverMinSpend           Int      @default(3000000)
  goldMinSpend             Int      @default(10000000)
  diamondMinSpend          Int      @default(25000000)
  memberFreeShipThreshold  Int      @default(500000)
  silverFreeShipThreshold  Int      @default(400000)
  goldFreeShipThreshold    Int      @default(300000)
  diamondFreeShipThreshold Int      @default(0)
  updatedAt                DateTime @updatedAt
}

// Tài khoản nhận chuyển khoản (VietQR) do Admin cập nhật ở Cài đặt > Thanh toán. Một dòng duy nhất, id = "default"; chưa có thì dùng BANK_* trong .env.
model PaymentAccount {
  id          String   @id @default("default")
  bankName    String
  bankBin     String // mã BIN ngân hàng (vd MB Bank = 970422)
  accountNo   String
  accountName String // IN HOA không dấu
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  ORDER_STATUS // đơn hàng đổi trạng thái
  VOUCHER // nhận voucher mới (vd. voucher chào mừng khi lên hạng)
}

enum AdminNotificationCategory {
  ORDER // đơn mới, đơn bị huỷ
  PAYMENT // chờ xác nhận chuyển khoản
  STOCK // biến thể xuống dưới ngưỡng sắp hết hàng
}

// Hộp thư sự kiện cho Admin (chuông trang quản trị). MỘT luồng chung cho mọi Admin; trạng thái đọc theo từng Admin nằm ở
// User.adminNotificationsSeenAt. Tạo trong cùng transaction với sự kiện (đặt đơn, huỷ, thanh toán, trừ kho).
model AdminNotification {
  id        String                    @id @default(cuid())
  category  AdminNotificationCategory
  title     String
  body      String?
  href      String? // đường dẫn nội bộ khi bấm vào
  createdAt DateTime                  @default(now())

  reads AdminNotificationRead[]

  @@index([createdAt])
  @@index([category, createdAt])
}

// Đã đọc TỪNG thông báo, theo từng Admin (bổ sung cho mốc User.adminNotificationsSeenAt). Xoá theo khi thông báo/Admin bị xoá.
model AdminNotificationRead {
  notificationId String
  userId         String
  createdAt      DateTime @default(now())

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId])
}

// Thông báo cho khách (chuông trên header). Tạo trong cùng transaction với lần đổi trạng thái đơn; `readAt` null = chưa đọc.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String? // đường dẫn nội bộ khi bấm vào thông báo
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
